[Unit]
Description=Lasair MMA ICGB service
After=network.target

[Service]
Type=simple
User={{ ansible_user_id }}
WorkingDirectory={{ ansible_env.HOME }}/{{ git_name}}/services/externalBrokers/mma_hopskotch
ExecStart={{ venv_path }}/bin/python3 downloadMMAlerts.py --namespace=ICGB
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target